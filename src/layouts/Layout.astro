---
import '../globals.css';

import TopBar from "@/components/site/TopBar.astro";
import { getLangFromUrl, getCV, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const CV = getCV(lang);
const t = useTranslations(lang);

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string[];
}

const { 
  title,
  image = CV.basics.image,
  canonicalURL = CV.basics.url,
  keywords = [
    "Andrés Giraldo",
    "Full Stack Software Engineer",
    "Frontend Developer",
    "Backend Developer",
    "Web Developer",
    "Software Engineer",
    "Vue Developer",
    "Nuxt Developer",
    "Angular Developer",
    "Java Developer",
    "Spring Boot",
    "TypeScript Developer",
    "Cali",
    "Colombia",
    "Portfolio",
    "Ideamosmas",
    "Controlo",
    "Exploreti",
    "Parking Mobile"
  ]
} = Astro.props;

const { url, name, location } = CV.basics;
const { city, region } = location;

const detailedDescription = `${CV.basics.name}. ${t("meta.description")}`;

// Create structured data for better SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": name,
  "jobTitle": CV.basics.label,
  "url": url,
  "email": CV.basics.email,
  "alumniOf": CV.education?.[0]?.institution,
  "knowsLanguage": CV.languages?.map(l => l.language),
  "sameAs": CV.basics.profiles.map(profile => profile.url),
  "image": image,
  "description": detailedDescription,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": region,
    "addressCountry": "CO"
  },
  "knowsAbout": CV.skills.map(skill => skill.name),
  "worksFor": CV.work?.map(work => ({
    "@type": "Organization",
    "name": work.name,
    "position": work.position
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Work",
      "item": `${url}#work`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "About",
      "item": `${url}#about`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "Contact",
      "item": `${url}#contact`
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={detailedDescription} />
    <meta name="author" content={name} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="geo.region" content="CO-VAC" />
    <meta name="geo.placename" content={city} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={new URL(lang === "es" ? "/es/" : "/", canonicalURL).href} />
    <link rel="alternate" hreflang="en" href={new URL("/", canonicalURL).href} />
    <link rel="alternate" hreflang="es" href={new URL("/es/", canonicalURL).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", canonicalURL).href} />
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={detailedDescription} />
    <meta property="og:image" content={new URL(image, url).href} />
    <meta property="og:site_name" content={`${name}'s Portfolio`} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={detailedDescription} />
    <meta name="twitter:image" content={new URL(image, url).href} />
    {CV.basics.profiles.find(p => p.network === 'X / Twitter')?.username && 
      <meta name="twitter:creator" content={CV.basics.profiles.find(p => p.network === 'X / Twitter')?.username} />
    }
    
    <!-- Additional meta tags -->
    <meta name="theme-color" content="#121212" />
    <meta name="referrer" content="no-referrer" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    
    {CV?.analyticsCode && <script is:inline src={CV.analyticsCode} />}
    
  </head>
  <body>
    <a class="skip-link mono" href="#main">{t("nav.skip")}</a>
    <TopBar />
    <slot />
    <script src="../scripts/smooth-scroll.ts"></script>
  </body>
</html>
