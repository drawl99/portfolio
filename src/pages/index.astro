---
import Layout from "@layouts/Layout.astro";
import Home from "@/components/site/Home.astro";
import { getLangFromUrl, getBasics, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name } = getBasics(lang);
---

<Layout title={`${name} | ${t("hero.role")}`}>
  <Home />
</Layout>
