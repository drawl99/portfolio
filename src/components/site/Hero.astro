---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, getBasics } from "@/i18n";
import portrait from "@/assets/pfp.jpg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basics = getBasics(lang);
const [first, ...rest] = basics.name.split(" ");
const last = rest.join(" ");
const linkedin = basics.profiles.find((p) => p.network === "LinkedIn");
const github = basics.profiles.find((p) => p.network === "GitHub");
---

<section class="hero" aria-labelledby="hero-name">
  <p class="prompt mono" aria-hidden="true">
    <span class="user">andres@cali</span><span class="sep">:~$</span>
    <span class="cmd">whoami</span><span class="caret"></span>
  </p>

  <h1 id="hero-name" class="name">
    <span class="line">{first}</span>
    <span class="line">{last}</span>
  </h1>

  <div class="meta">
    <div class="who">
      <p class="role">{t("hero.role")}</p>
      <p class="based mono">{t("hero.based")}</p>
      <p class="status mono"><span class="dot" aria-hidden="true"></span>{t("hero.available")}</p>
    </div>

    <div class="actions">
      <a class="primary" href={`mailto:${basics.email}`}>
        {t("hero.email")}
        <Icon name="ri:arrow-up-line" class="rot" aria-hidden="true" />
      </a>
      {
        linkedin && (
          <a class="secondary" href={linkedin.url} target="_blank" rel="noopener">
            <Icon name="mdi:linkedin" aria-hidden="true" />
            {t("hero.linkedin")}
          </a>
        )
      }
      {
        github && (
          <a class="secondary" href={github.url} target="_blank" rel="noopener">
            <Icon name="mdi:github" aria-hidden="true" />
            {t("hero.github")}
          </a>
        )
      }
    </div>

    <figure class="portrait">
      <Image src={portrait} alt={t("hero.photoAlt")} width={320} height={320} loading="eager" fetchpriority="high" />
      <figcaption class="mono">3.4516° N · 76.5320° W</figcaption>
    </figure>
  </div>

  <a class="scroll mono" href="#about">{t("hero.scroll")} <Icon name="ri:arrow-down-line" aria-hidden="true" /></a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--bar-h) + clamp(1.25rem, 3.5vh, 3rem)) var(--gutter) clamp(1.5rem, 3.5vh, 2.5rem);
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: clamp(0.75rem, 2vh, 1.5rem);
  }

  .prompt {
    color: var(--bone-dim);
    text-transform: none;
    font-size: 0.875rem;
    letter-spacing: 0;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .user {
    color: var(--lime);
  }
  .cmd {
    margin-left: 0.5rem;
    color: var(--bone);
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 6ch;
    animation: type 0.9s steps(6, end) 0.3s both;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.1rem;
    background: var(--orange);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes type {
    from {
      width: 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: "opsz" 96;
    font-size: clamp(3.5rem, 21.5vw, 21rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .line {
    display: block;
    animation: rise 1.1s var(--ease-out) both;
  }
  .line:nth-child(2) {
    animation-delay: 0.08s;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--bone);
    letter-spacing: -0.025em;
  }
  @keyframes rise {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.25em);
    }
    to {
      clip-path: inset(0 0 -10% 0);
      transform: none;
    }
  }

  .meta {
    align-self: end;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--rule-strong);
    padding-top: 1.5rem;
  }

  .role {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.4vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .based {
    margin: 0.75rem 0 0;
    color: var(--bone-dim);
  }
  .status {
    margin: 0.5rem 0 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--bone);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--lime);
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(198, 244, 50, 0.6);
    animation: pulse 2.2s var(--ease-out) infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.55rem rgba(198, 244, 50, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(198, 244, 50, 0);
    }
  }

  .actions {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .portrait {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--bone);
    transition:
      background 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .actions svg {
    width: 1rem;
    height: 1rem;
  }
  .actions .rot {
    transform: rotate(45deg);
  }
  .primary {
    background: var(--orange);
    border-color: var(--orange) !important;
    color: var(--ink);
  }
  .primary:hover {
    background: var(--bone);
    border-color: var(--bone) !important;
  }
  .secondary:hover {
    background: var(--bone);
    color: var(--ink);
  }

  .portrait {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    justify-items: end;
  }
  .portrait img {
    width: clamp(5.5rem, 9vw, 8.5rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
    transition: filter 0.5s var(--ease-out);
  }
  .portrait:hover img {
    filter: none;
  }
  .portrait figcaption {
    color: var(--bone-dim);
    font-size: 0.625rem;
  }

  .scroll {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--bar-h) + clamp(1.25rem, 3.5vh, 3rem));
    color: var(--bone-dim);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .scroll svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      gap: 1.25rem;
    }
    .meta {
      margin-top: clamp(1.5rem, 6vh, 3rem);
    }
    .actions {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .portrait {
      grid-row: 1;
    }
    .scroll {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .line:nth-child(2) {
      -webkit-text-stroke-width: 1px;
    }
    .actions a {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
