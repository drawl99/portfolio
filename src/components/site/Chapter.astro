---
interface Props {
  id: string;
  index: number;
  title: string;
  tone: "orange" | "cobalt" | "lime" | "sodium" | "bone";
  count?: number;
  flush?: boolean;
  class?: string;
}

const { id, index, title, tone, count, flush = false, class: className } = Astro.props;
const num = String(index).padStart(2, "0");
---

<section id={id} class:list={["chapter", className]} data-tone={tone} aria-labelledby={`${id}-title`} tabindex="-1">
  <header class="band">
    <h2 id={`${id}-title`}>
      <span class="idx mono" aria-hidden="true">[{num}]</span>
      {title}
      {count !== undefined && <sup class="mono">{count}</sup>}
    </h2>
    <span class="num mono" aria-hidden="true">{num} / 06</span>
  </header>
  <p class:list={["giant", { flush }]} aria-hidden="true">{title}</p>
  <div class:list={["body", { flush }]}>
    <slot />
  </div>
</section>

<style>
  .chapter {
    position: relative;
    outline: none;
  }

  .band {
    position: sticky;
    top: var(--bar-h);
    z-index: 20;
    height: var(--band-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 var(--gutter);
    background: var(--tone);
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  [data-tone="orange"] { --tone: var(--orange); }
  [data-tone="cobalt"] { --tone: var(--cobalt); }
  [data-tone="lime"] { --tone: var(--lime); }
  [data-tone="sodium"] { --tone: var(--sodium); }
  [data-tone="bone"] { --tone: var(--bone); }
  [data-tone="cobalt"] .band { color: var(--bone); border-bottom-color: var(--graphite); }

  h2 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: "opsz" 48;
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  h2 .idx {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transform: translateY(-0.4em);
  }
  h2 sup {
    font-size: 0.75rem;
    font-weight: 500;
    top: -1.2em;
  }

  .num {
    font-size: 0.75rem;
  }

  .giant {
    margin: 0;
    padding: clamp(2.5rem, 6vw, 5rem) var(--gutter) 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: "opsz" 96;
    font-size: clamp(3.25rem, 11vw, 12rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--giant, var(--bone));
    overflow-wrap: anywhere;
  }
  .giant + .body {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  .giant.flush + .body {
    padding-top: 0;
  }
  [data-tone="orange"] .giant { --giant: var(--orange); }
  [data-tone="cobalt"] .giant { --giant: var(--cobalt-text); }
  [data-tone="lime"] .giant { --giant: var(--lime); }
  [data-tone="sodium"] .giant { --giant: var(--sodium); }

  .band :global(:focus-visible) {
    outline-color: var(--ink);
  }

  .body {
    padding: clamp(3rem, 8vw, 7rem) var(--gutter);
  }

  @media (max-width: 560px) {
    h2 {
      white-space: nowrap;
      font-size: clamp(1.25rem, 6.4vw, 1.75rem);
      gap: 0.5rem;
    }
    .num {
      display: none;
    }
  }
  .body.flush {
    padding: 0;
  }
</style>
