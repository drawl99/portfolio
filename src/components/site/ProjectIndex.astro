---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, getProjects } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = getProjects(lang).filter((p) => !p.featured);
const offset = getProjects(lang).filter((p) => p.featured).length;

const shots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/work/*.webp", { eager: true });
const shotFor = (cover: string | null) => (cover ? shots[`/src/assets/work/${cover}.webp`]?.default : undefined);
---

<ol class="grid">
  {
    projects.map((p, i) => {
      const shot = shotFor(p.cover);
      const stack = Object.entries(p.stack);
      return (
        <li class="cell">
          {shot && (
            <Image
              class="thumb"
              src={shot}
              alt={t("work.shotAlt").replace("{name}", p.name)}
              widths={[480, 720]}
              sizes="(max-width: 700px) 92vw, 30vw"
              loading="lazy"
            />
          )}

          <h3>
            <span class="idx mono" aria-hidden="true">{String(offset + i + 1).padStart(2, "0")}</span>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener">
                {p.name}
                <Icon name="ri:arrow-up-line" class="go" aria-hidden="true" />
              </a>
            ) : (
              p.name
            )}
          </h3>
          <p class="desc">{p.tagline}</p>
          {!p.url && !p.github && <p class="state mono">{t("work.private")}</p>}

          <details>
            <summary class="mono">
              <Icon name="ri:arrow-right-s-line" aria-hidden="true" />
              {t("index.details")}
            </summary>
            <ul>
              {p.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </details>

          <div class="foot">
            <ul class="chips">
              {stack.slice(0, 4).map(([name, icon]) => (
                <li class="chip">
                  <Icon name={icon as string} aria-hidden="true" />
                  {name}
                </li>
              ))}
              {stack.length > 4 && (
                <li class="chip" title={stack.slice(4).map(([n]) => n).join(", ")}>
                  +{stack.length - 4}
                </li>
              )}
            </ul>
            {p.github && (
              <a class="gh" href={p.github} target="_blank" rel="noopener" aria-label={`${t("work.code")}: ${p.name}`}>
                <Icon name="mdi:github" aria-hidden="true" />
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    transition: background 0.35s var(--ease-out);
  }
  .cell:hover {
    background: var(--graphite-2);
  }


  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
    filter: grayscale(0.6);
    transition: filter 0.4s var(--ease-out);
  }
  .cell:hover .thumb {
    filter: none;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: "opsz" 48;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  h3 a {
    text-decoration: none;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.25rem;
  }
  h3 a:hover {
    color: var(--sodium);
  }
  .go {
    width: 1rem;
    height: 1rem;
    transform: rotate(45deg);
    margin-top: 0.15rem;
  }

  .desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--bone);
  }

  details {
    border-top: 1px solid var(--rule);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0;
    color: var(--bone-dim);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s var(--ease-out);
  }
  details[open] summary svg {
    transform: rotate(90deg);
  }
  h3 .idx {
    margin-right: 0.5rem;
    vertical-align: 0.35em;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sodium);
  }
  .state {
    margin: 0;
    color: var(--bone-dim);
    font-size: 0.6875rem;
  }
  summary:hover {
    color: var(--bone);
  }
  details ul {
    margin: 0;
    padding: 0 0 0.5rem 1rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--bone-dim);
  }

  .foot {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    color: var(--bone-dim);
  }
  .gh {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule-strong);
  }
  .gh:hover {
    color: var(--ink);
    background: var(--sodium);
    border-color: var(--sodium);
  }
  .gh svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
