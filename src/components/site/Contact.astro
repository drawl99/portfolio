---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, getBasics } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basics = getBasics(lang);
const profiles = basics.profiles.filter((p) => p.network !== "Email");
const year = new Date().getFullYear();
---

<div class="contact">
  <p class="lead">{t("contact.lead")}</p>

  <a class="email" href={`mailto:${basics.email}`}>
    <span>{basics.email}</span>
    <Icon name="ri:arrow-up-line" aria-hidden="true" />
  </a>

  <div class="row">
    <button class="copy mono" type="button" data-copy={basics.email} data-done={t("contact.copied")}>
      {t("contact.copy")}
    </button>
    <ul class="profiles">
      {
        profiles.map((p) => (
          <li>
            <a class="arrow-link" href={p.url} target="_blank" rel="noopener">
              <Icon name={p.icon} aria-hidden="true" />
              {p.network}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<footer class="foot mono">
  <span>© {year} {basics.name}</span>
  <span>{t("contact.footer")}</span>
  <span>{basics.location.city}, {basics.location.region}</span>
</footer>

<style>
  .contact {
    color: var(--ink);
  }
  .lead {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "opsz" 48;
    font-size: clamp(1.75rem, 4vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .email {
    margin-top: clamp(2rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0 1rem;
    border-bottom: 2px solid var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: "opsz" 96;
    font-size: clamp(1.75rem, 6.6vw, 7rem);
    line-height: 1;
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .email svg {
    flex: none;
    width: 0.7em;
    height: 0.7em;
    transform: rotate(45deg);
    transition: transform 0.45s var(--ease-out);
  }
  .email:hover svg {
    transform: rotate(45deg) translateY(-0.12em);
  }
  .email:focus-visible,
  .copy:focus-visible,
  .profiles a:focus-visible {
    outline-color: var(--ink);
  }

  .row {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .copy {
    background: var(--ink);
    color: var(--orange);
    border: 0;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--bone);
  }
  .profiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
  }

  .foot {
    margin-top: clamp(4rem, 9vw, 8rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink-rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    color: var(--ink);
    font-size: 0.6875rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    const label = button.textContent ?? "";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = button.dataset.done ?? label;
        setTimeout(() => (button.textContent = label), 1800);
      } catch {
        window.location.href = `mailto:${button.dataset.copy}`;
      }
    });
  });
</script>
